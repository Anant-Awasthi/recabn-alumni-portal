rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /alumni_registrations/{document} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
    match /contact_messages/{document} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
    match /mail/{document} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
  }
}